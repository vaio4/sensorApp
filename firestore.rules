rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // UserProfile Validation Blueprint
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'dailyStepGoal',
          'samplingIntervalMs',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'dailyStepGoal',
          'samplingIntervalMs',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.dailyStepGoal is int && data.dailyStepGoal >= 500 && data.dailyStepGoal <= 100000
        && data.samplingIntervalMs is int && data.samplingIntervalMs >= 250 && data.samplingIntervalMs <= 60000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // RecordingSessionMeta Validation Blueprint
    function isValidSessionMeta(data, userId, sessionId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'startedAt',
          'endedAt',
          'sampleCount',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'startedAt',
          'endedAt',
          'sampleCount',
          'createdAt'
        ])
        && data.id is string && data.id == sessionId && isValidId(data.id)
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.startedAt is string && data.startedAt.size() >= 10 && data.startedAt.size() <= 64
        && data.endedAt is string && data.endedAt.size() >= 10 && data.endedAt.size() <= 64
        && data.sampleCount is int && data.sampleCount >= 0 && data.sampleCount <= 1000000
        && data.createdAt is timestamp;
    }

    // Private User Profile (PII Isolated to Owner Only)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'email',
          'dailyStepGoal',
          'samplingIntervalMs',
          'updatedAt'
        ]);

      allow delete: if false;

      // User-Owned Recording Session Summaries
      match /sessions/{sessionId} {
        allow get: if isValidId(userId) && isValidId(sessionId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(sessionId)
          && isOwner(userId)
          && isValidSessionMeta(incoming(), userId, sessionId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(sessionId) && isOwner(userId);
      }
    }

    // Connection validation document (read-only health check, no PII)
    match /test/connection {
      allow get: if isSignedIn();
      allow list, write: if false;
    }
  }
}
